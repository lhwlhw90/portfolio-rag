# --- paths (models are NEVER stored in ~/.cache; HF_HOME etc. are pointed here) ---
MODEL_DIR=./models
DATA_DIR=./data

# --- embeddings: fastembed (ONNX, CPU) | hash (deterministic, no model; tests/offline) ---
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
HYBRID_ALPHA=0.5          # 1.0 = vector only, 0.0 = BM25 only
ANSWER_MIN_SCORE=0.58     # extractive answerer "not found" threshold
MAX_UPLOAD_MB=20

# --- answerer: extractive (default, no LLM) | openai (any OpenAI-compatible endpoint) ---
LLM_BACKEND=extractive
# Ollama:          http://localhost:11434/v1   (from Docker: http://host.docker.internal:11434/v1)
# llama.cpp server: http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:0.5b
LLM_API_KEY=not-needed
LLM_TIMEOUT=60

# Set to 1 after `make download-model` to guarantee no network access for models
# HF_HUB_OFFLINE=1
